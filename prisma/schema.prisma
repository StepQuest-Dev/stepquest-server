generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  character    Character?
  steps        StepRecord[]
}

model Character {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  level     Int      @default(1)
  exp       Int      @default(0)
  gold      Int      @default(0)
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  
  hp          Int      @default(100)
  maxHp       Int      @default(100)
  attack      Int      @default(10)
  defense     Int      @default(5)

  totalSteps Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  battles     Battle[]
  combatSessions CombatSession[]
  discoveredPlaces DiscoveredPlace[]
}

model StepRecord {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @unique
  count      Int
  recordedAt DateTime @default(now())
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Enemy {
  id          String   @id @default(uuid())
  name        String
  level       Int
  hp          Int
  attack      Int
  defense     Int
  goldReward  Int
  expReward   Int
  imageUrl    String?  // Link do assetu w aplikacji RN
  battles     Battle[]
  combatSessions  CombatSession[]
}

model Battle {
  id          String   @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  enemyId     String
  enemy       Enemy     @relation(fields: [enemyId], references: [id])
  
  status      BattleStatus @default(PENDING) // PENDING, WON, LOST
  log         Json?        // Przebieg walki (np. tablica uderzeń)
  
  createdAt   DateTime @default(now())

  sessionId   String?
  session     CombatSession? @relation(fields: [sessionId], references: [id])
}

enum BattleStatus {
  PENDING
  WON
  LOST
}

model CombatSession {
  id          String        @id @default(uuid())
  characterId String
  character   Character     @relation(fields: [characterId], references: [id])
  enemyId     String
  enemy       Enemy         @relation(fields: [enemyId], references: [id])
  status      BattleStatus  @default(PENDING)
  createdAt   DateTime      @default(now())

  battles     Battle[]
}

enum CombatAction {
  ATTACK
  FLEE
  USE_ITEM
}

model Class {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  
  // Statystyki bazowe
  baseHp      Int
  baseAttack  Int
  baseDefense Int
  
  // Współczynniki wzrostu na level
  hpPerLevel      Int
  attackPerLevel  Int
  defensePerLevel Int

  bonus           ClassBonus

  characters  Character[]
}

enum ClassBonus {
  WARRIOR       // Wojownik: +20% obrażeń przy HP < 50%
  SCOUT           // Zwiadowca: wyższy cap kroków 2000 więcej, do 70%
  DOUBLE_STRIKE   // Czarnoksiężnik: co 3. tura podwójne obrażenia
  MONK_REGEN      // Mnich: 1000 HP, 1 DMG, 2% na automatyczną wygraną, brak skalowania obrażeń z poziomem
}

model DiscoveredPlace {
  id           String    @id @default(uuid())
  characterId  String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name         String
  lat          Float
  lon          Float
  osmId        String
  discoveredAt DateTime  @default(now())
  isCollected  Boolean   @default(false)
  collectedAt  DateTime?
}
